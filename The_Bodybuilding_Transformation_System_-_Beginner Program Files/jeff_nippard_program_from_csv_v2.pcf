jeffNippardBodybuildingTransformationSystem {
  name = "The Bodybuilding Transformation System - Beginner"
  arthur = "Jeff Nippard"
  shortDescription = ""
  description = """
      IMPORTANT PROGRAM NOTES (READ BEFORE STARTING)
      ● Perform a full general warm-up and exercise-specific warm-up every workout as outlined below (should only take 5-10 mins max)
      
      ● Note that for the first week of the program, most sets are taken to an RPE of ~6-7. This means you will be leaving 3-4 reps in the tank on most exercises. This only lasts for the first week (to serve as a deload/intro week). After the first week, the intensity will increase and you’ll start taking most sets to ~2-3 reps shy of failure.
      
      ● All working sets are broken up into Early Sets and Last Sets. The Early Sets are all the sets that come before your Last Set. Usually the Early Sets should be a little bit easier than the later sets (slightly lower RPE) whereas the Last Set is pushed closer to failure. In the first two weeks of the program, there will only be one working set for each exercise, so there is only a Last Set RPE. See the Bodybuilding Transformation System Guidebook for a full explanation of RPE.
      
      ● Each exercise has a clickable link which demonstrates how to perform the exercise. I suggest watching each exercise demo before starting the workout.
      
      ● All other aspects of the program, including when to make an exercise substitution and how to progress through the rep ranges given is explained in the Bodybuilding Transformation System Guidebook. Give it a full read before starting your first workout! Let's crush it!!
    """
  programLength = "12 Weeks"
  uri = ""
  level = "Beginner"
  programEquipment = "Full Gym"
  daysPerWeek = "5 training days per week (with 2 rest days implied by structure)"
  mesocycles {
    new {
      name = "Foundation Block"
      description = "Weeks 1-5. Focus on mastering technique and building a solid foundation. Weeks 1-2 feature 1 working set per exercise. Weeks 3-5 progress to 2 working sets per exercise with increasing RPE targets."
      order = 1
      microcycles {
        new {
          name = "Week 1"
          description = "Training for week 1."
          order = 1
          workouts {}
          advancedWorkouts {
            new {
              name = "UPPER (STRENGTH FOCUS)"
              day = 1
              notes {
                "Perform a full general warm-up and exercise-specific warm-up (5-10 mins max)."
              }
              exercisesSets {}
              advancedExercisesSets {
                new {
                  name = "45° Incline Barbell Press"
                  description = """
                      <p><strong>Execution Notes:</strong></p><p>1 second pause at the bottom of each rep while maintaining tension on the pecs</p>
                      <p><strong>Protocol Details:</strong></p><ul><li><strong>Rest:</strong> 3-5 min</li><li><strong>Warm-up Sets:</strong> 2-3</li></ul>
                      <p><strong>Substitution Options:</strong></p><ul><li>45° Incline DB Press</li><li>45° Incline Machine Press</li></ul>
                    """
                  notes {}
                  sets = 0
                  setType = 1
                  repetitions = null
                  targetRepetitionsInReserve = null
                  targetRatePerceivedEffort {
                    6
                  }
                  targetWeightPounds = null
