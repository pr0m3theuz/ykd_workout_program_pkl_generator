                          6
                        }
                      minRepetitions = 6
                      maxRepetitions = 8
                      }
                    }
                  }
                  new AdvancedExerciseSets {
                  name = "Barbell Straight-back Straight-leg Deadlift"
                  description = "<p><strong>Execution Notes:</strong></p><p>To keep tension on the hamstrings, stop about 75% of the way to full lockout on each rep (i.e. stay in the bottom 3/4 of the range of motion).</p><p><strong>Protocol Details:</strong></p><ul><li><strong>Rest:</strong> 2-3 min</li><li><strong>Warm-up Sets:</strong> 2-4</li></ul><p><strong>Substitution Options:</strong></p><ul><li>Dumbbell Straight-back Straight-leg Deadlift</li><li>Romanian Deadlift</li></ul>"
                  notes = new Listing<String> {}
