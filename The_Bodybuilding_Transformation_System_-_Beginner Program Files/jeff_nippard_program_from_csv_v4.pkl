                }
              }
              new AdvancedWorkout {
              name = "LOWER (STRENGTH FOCUS)"
              day = 2
              notes = new Listing<String> {
                  "Perform a full general warm-up and exercise-specific warm-up (5-10 mins max)."
                }
              advancedExercisesSets = new Listing<AdvancedExerciseSets> {
                  new AdvancedExerciseSets {
                  name = "Lever Lying Leg Curl"
                  description = "<p><strong>Execution Notes:</strong></p><p>Set the machine so that you get the biggest stretch possible at the bottom. Prevent your butt from popping up as you curl.</p><p><strong>Protocol Details:</strong></p><ul><li><strong>Rest:</strong> 1-2 min</li><li><strong>Warm-up Sets:</strong> 2</li></ul><p><strong>Substitution Options:</strong></p><ul><li>Lever Seated Leg Curl</li><li>Nordic Ham Curl</li></ul>"
                  notes = new Listing<String> {}
                  sets = 0
                  setScheme = new Listing<SetScheme> {
                      warmUpScheme2Sets
                      new SetScheme {
                      sets = 1
                      repetitions = new Listing<Int> {}
                      targetRatePerceivedEffort = new Listing<Int> {
                          7
                        }
                      minRepetitions = 8
                      maxRepetitions = 10
                      }
                    }
                  }
                  new AdvancedExerciseSets {
                  name = "Smith Squat"
                  description = "<p><strong>Execution Notes:</strong></p><p>Once you are under the bar, set up your feet as you would a normal squat and then bring them forward 3-6 inches. This will cause you to lean back into the bar slightly, allowing for a more upright squat, while also placing more tension on the quads. If your heels are raising at the bottom, you may need to bring your feet more forward. If your feet feel like they are slipping or your lower back is rounding at the bottom, try bringing your feet back a bit.</p><p><strong>Protocol Details:</strong></p><ul><li><strong>Rest:</strong> 3-5 min</li><li><strong>Warm-up Sets:</strong> 2-4</li></ul><p><strong>Substitution Options:</strong></p><ul><li>Dumbbell Single Leg Split Squat</li><li>Barbell Full Squat</li></ul>"
                  notes = new Listing<String> {}
