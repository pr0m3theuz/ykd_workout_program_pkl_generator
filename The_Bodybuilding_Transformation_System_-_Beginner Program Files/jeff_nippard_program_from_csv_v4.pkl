                  new AdvancedExerciseSets {
                  name = "Cable Forward Triceps Extension"
                  description = "<p><strong>Execution Notes:</strong></p><p>Optionally pause for 0.5-1 second in the stretched aspect of each rep</p><p><strong>Protocol Details:</strong></p><ul><li><strong>Rest:</strong> 1-2 min</li><li><strong>Warm-up Sets:</strong> 1</li></ul><p><strong>Substitution Options:</strong></p><ul><li>Cable Triceps Extension (with rope)</li><li>Dumbbell Lying Triceps Extension</li></ul>"
                  notes = new Listing<String> {}
                  sets = 0
