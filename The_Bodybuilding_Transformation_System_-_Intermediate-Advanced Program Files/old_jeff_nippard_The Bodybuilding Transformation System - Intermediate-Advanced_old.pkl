                  "Perform a full general warm-up and exercise-specific warm-up (5-10 mins max)."
                }
              advancedExercisesSets = new Listing<AdvancedExerciseSets> {
                  new AdvancedExerciseSets {
                  name = "Barbell Incline Bench Press"
                  notes = new Listing<String> {
                      "Warm-up Sets: 2-3"
                      "Rest: 3-5 min"
                      "Substitution Option 1: Dumbbell Incline Bench Press"
                      "Substitution Option 2: Lever Incline Bench Press"
                      "1 second pause at the bottom of each rep while maintaining tension on the pecs"
